{
  "name": "bikeai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.20.0 <25",
    "pnpm": ">=10.34.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "pnpm --filter bikeai-backend dev",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend": "tsc -b && vite build",
    "build:backend": "pnpm --filter bikeai-backend build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "pnpm --filter bikeai-backend start",
    "prisma:generate": "pnpm --filter bikeai-backend prisma:generate",
    "prisma:deploy": "pnpm --filter bikeai-backend prisma:deploy",
    "db:seed": "pnpm --filter bikeai-backend db:seed",
    "deploy:check": "pnpm install --frozen-lockfile --prod=false && pnpm run prisma:generate && pnpm run build"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "onnxruntime-node"
    ]
  }
}
