# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
RATE_LIMIT_MAX=300

# --- Database (MySQL 8.x) ---
DATABASE_URL="mysql://bikeai:bikeai@localhost:3306/bikeai"

# --- Auth ---
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- Optional integrations (kept for parity with original Supabase project) ---
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
